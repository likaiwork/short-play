generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model DownloadRecord {
  id          String   @id @default(cuid())
  url         String
  title       String?
  downloadUrl String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())
}
